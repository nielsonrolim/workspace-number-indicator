<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.workspace-number-indicator"
          path="/org/gnome/shell/extensions/workspace-number-indicator/">
    <key name="show-total" type="b">
      <default>true</default>
      <summary>Show total number of workspaces</summary>
      <description>When enabled, displays the current workspace as "current / total" (e.g. 2 / 4). When disabled, shows only the current number (e.g. 2).</description>
    </key>
    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'left'</default>
      <summary>Panel position</summary>
      <description>Where to display the indicator in the top bar: "left" or "right".</description>
    </key>
    <key name="left-placement" type="s">
      <choices>
        <choice value="before"/>
        <choice value="after"/>
      </choices>
      <default>'after'</default>
      <summary>Left box placement</summary>
      <description>When placed on the left, whether to appear before or after the Activities button.</description>
    </key>
    <key name="hide-workspace-pills" type="b">
      <default>false</default>
      <summary>Hide workspace pills</summary>
      <description>When enabled, hides the Activities button and its workspace pills from the top bar.</description>
    </key>
    <key name="enable-switch-shortcuts" type="b">
      <default>false</default>
      <summary>Switch to workspace shortcuts</summary>
      <description>When enabled, Super+1…0 switches to workspace 1…10.</description>
    </key>
    <key name="enable-move-shortcuts" type="b">
      <default>false</default>
      <summary>Move to workspace shortcuts</summary>
      <description>When enabled, Shift+Super+1…0 moves the focused window to workspace 1…10 and follows it.</description>
    </key>
    <key name="shortcut-switch-to-workspace-1" type="as">
      <default><![CDATA[['<Super>1']]]></default>
      <summary>Switch to workspace 1</summary>
    </key>
    <key name="shortcut-switch-to-workspace-2" type="as">
      <default><![CDATA[['<Super>2']]]></default>
      <summary>Switch to workspace 2</summary>
    </key>
